# Optional override used by both installers. If omitted, the public IP is detected.
NEXUSROOM_PUBLIC_IP=203.0.113.10

# Optional host-side HTTP port. The container always listens on 8080.
NEXUSROOM_HTTP_PORT=8080

# Optional TURN relay range override, useful when the host reserves 51000-51100.
NEXUSROOM_TURN_RELAY_PORT_RANGE=51000-51100
