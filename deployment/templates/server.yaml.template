server:
  port: 8080
  mode: release
  domain: ""

database:
  path: "DATA_DIR/nexusroom.db"

auth:
  jwt_secret: "CHANGE_ME_JWT"
  jwt_expire_hours: 720
  admin_token: "CHANGE_ME_ADMIN"

message:
  retention_days: 30

media:
  public_ip: "YOUR_IP"
  rtc:
    udp_port_min: 50000
    udp_port_max: 50050
  rtmp:
    port: 1935
  turn:
    enabled: true
    port: 3478
    realm: nexusroom
    username: "CHANGE_ME_TURN_USER"
    password: "CHANGE_ME_TURN_PASSWORD"
    relay_port_min: 51000
    relay_port_max: 51100

wireguard:
  server_ip: "YOUR_IP"
  listen_port: 51820
  server_private_key: ""
  private_key_path: "DATA_DIR/wireguard.key"
  subnet: "10.0.8.0/24"
  gateway_ip: "10.0.8.1"

storage:
  path: "DATA_DIR/uploads"
  max_file_size_mb: 20
