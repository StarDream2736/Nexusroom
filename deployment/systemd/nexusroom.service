[Unit]
Description=NexusRoom unified server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nexusroom
Group=nexusroom
WorkingDirectory=/etc/nexusroom
ExecStart=/usr/local/bin/nexusroom
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nexusroom

[Install]
WantedBy=multi-user.target
