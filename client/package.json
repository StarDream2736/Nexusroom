{
  "name": "nexusroom-electron",
  "version": "3.0.0",
  "private": true,
  "description": "NexusRoom desktop client.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "check:sqlite": "electron scripts/check-node-sqlite.mjs",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.build.json",
    "build": "npm run typecheck && npm run lint && npm run test && npm run build:renderer && npm run build:electron",
    "package:win": "npm run build && electron-builder --win zip --x64"
  },
  "dependencies": {
    "mpegts.js": "1.8.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "electron": "39.8.10",
    "electron-builder": "26.15.3",
    "eslint": "9.39.5",
    "typescript": "5.8.2",
    "typescript-eslint": "8.26.0",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  },
  "build": {
    "appId": "com.stardream.nexusroom",
    "productName": "NexusRoom",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!**/*.map",
      "package.json",
      "assets/runtime/**/*"
    ],
    "extraFiles": [
      {
        "from": "native/wg-helper/nexusroom-wg.exe",
        "to": "nexusroom-wg.exe"
      },
      {
        "from": "native/wg-helper/wintun.dll",
        "to": "wintun.dll"
      }
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "artifactName": "NexusRoom-${version}-windows-x64.${ext}"
  }
}
